# Copy to .env (loaded by `make`), then adjust. Every variable has a safe
# development default unless marked REQUIRED.

# development | test | production
APP_ENV=development
PORT=8000
# internal Prometheus listener; 0 disables
METRICS_PORT=9090

# --- PostgreSQL (REQUIRED) ---
DATABASE_URL=postgres://postgres@localhost:5432/irate_core_go?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=10s
# true = apply migrations on startup (advisory-locked)
AUTO_MIGRATE=false

# --- Redis (rate limits, login lockout, token denylist) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth --- generate secrets with: openssl rand -hex 32
# REQUIRED in production, >= 32 chars
JWT_ACCESS_SECRET=
# set to the old secret while rotating keys
JWT_ACCESS_SECRET_PREVIOUS=
JWT_ISSUER=irate-core
JWT_AUDIENCE=irate-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
# tolerated window for racing refreshes
REFRESH_REUSE_GRACE=20s
# must match IRATE_BACKEND_REFRESH_COOKIE in the BFF
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_PATH=/api/v1/auth
# forced true in production
COOKIE_SECURE=false
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=15m
MAX_CONCURRENT_PASSWORD_HASHES=8

# --- HTTP ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:9000
# 1 behind a single load balancer
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=20s

# --- Money (all amounts in minor units: 100 = NGN 1.00) ---
DEFAULT_CURRENCY=NGN
SUPPORTED_CURRENCIES=NGN
# NGN 10,000,000.00
MAX_TRANSACTION_AMOUNT_MINOR=1000000000
# NGN 50,000.00; 0 = no cap
UNVERIFIED_DAILY_TRANSFER_LIMIT_MINOR=5000000
BUSINESS_TIMEZONE=Africa/Lagos
IDEMPOTENCY_TTL=24h

# --- Payments ---
# sandbox | paystack (provider used for NEW deposits)
PAYMENTS_PROVIDER=sandbox
# REQUIRED in production when PAYMENTS_PROVIDER=sandbox, >= 32 chars
SANDBOX_WEBHOOK_SECRET=
# Paystack (REQUIRED when PAYMENTS_PROVIDER=paystack): sk_test_... or sk_live_...
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# where Paystack sends the customer after checkout (optional)
PAYSTACK_CALLBACK_URL=
PUBLIC_BASE_URL=http://localhost:8000
# forced false in production
PAYMENTS_SANDBOX_SIMULATION=true

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=debug
# text | json
LOG_FORMAT=text

# --- Seed (go run ./cmd/seed) ---
SEED_ADMIN_EMAIL=admin@irate.dev
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=Password123!

# --- Integration tests (make test-integration) — these databases are WIPED ---
TEST_DATABASE_URL=postgres://postgres@localhost:5432/irate_core_go_test?sslmode=disable
TEST_REDIS_URL=redis://127.0.0.1:6379/15
